{
  "version": "2.0.0",
  "tasks": [
    {
      // **F5はこちらを使う。** 本番ビルド（npm: build）では、開発用の道具
      // （実機確認を回すヘルパー）を枝ごと落としているため、F5で出なくなる。
      // 設計書6.26
      "type": "npm",
      "script": "build:dev",
      "problemMatcher": "$esbuild",
      "label": "npm: build:dev"
    },
    {
      "type": "npm",
      "script": "build",
      "problemMatcher": "$esbuild",
      "group": { "kind": "build", "isDefault": true },
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": "$esbuild-watch",
      "label": "npm: watch"
    }
  ]
}
