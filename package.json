{
  "name": "novel-ai-assistant",
  "displayName": "統合小説執筆環境",
  "description": "小説執筆のための統合環境。作品を登録して話数・文字数・執筆量を管理し、本文から登場人物や世界観などの設定資料を抽出します。プロットの逆算、あらすじ・紹介文・キャッチコピーの生成、各話の盛り上がりを見る感情曲線、誤字脱字と表記ゆれの検知、開いている画面についてのAI相談まで、執筆の前後を通して支えます。必要なもの（Ollama本体・モデル・Git）は拡張機能の中から入れられます。AIはOllama（無料・ローカル）とClaude・ChatGPT・Gemini・さくらのAI Engineから選べ、原稿を勝手に書き換えることはありません。",
  "version": "0.19.5",
  "publisher": "nonahisa",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#222733",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonahisa/novel-ai-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/nonahisa/novel-ai-assistant/issues"
  },
  "homepage": "https://github.com/nonahisa/novel-ai-assistant#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "小説",
    "執筆",
    "novel",
    "writing",
    "Ollama"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "browser": "./dist/browser-extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "novelai.manuscriptEditor",
        "displayName": "原稿（縦書き）",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.txt"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelai",
          "title": "統合小説執筆環境",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "novelaiIssues",
          "title": "提案",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "novelai": [
        {
          "id": "novelai.works",
          "name": "作品一覧",
          "when": "!novelai.focusChat"
        },
        {
          "id": "novelai.actions",
          "name": "操作メニュー",
          "when": "!novelai.focusChat"
        },
        {
          "id": "novelai.chatView",
          "name": "AIに相談",
          "type": "webview",
          "visibility": "collapsed"
        }
      ],
      "novelaiIssues": [
        {
          "id": "novelai.proposalsView",
          "name": "提案",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelai.works",
        "contents": "まだ作品が登録されていません。\n[フォルダから作品を追加](command:novelai.addWork)\n[新規作品を作成](command:novelai.createWork)\n[GitHubから作品を追加](command:novelai.addWorkFromGithub)"
      }
    ],
    "commands": [
      {
        "command": "novelai.addWork",
        "title": "フォルダから作品を追加",
        "category": "小説執筆",
        "icon": "$(add)"
      },
      {
        "command": "novelai.createWork",
        "title": "新規作品を作成",
        "category": "小説執筆",
        "icon": "$(new-folder)"
      },
      {
        "command": "novelai.removeWork",
        "title": "作品の登録を解除",
        "category": "小説執筆"
      },
      {
        "command": "novelai.createPlot",
        "title": "プロットをつくる",
        "category": "小説執筆",
        "icon": "$(list-tree)"
      },
      {
        "command": "novelai.setPlotBasics",
        "title": "形式とジャンルを決める",
        "category": "小説執筆",
        "icon": "$(tag)"
      },
      {
        "command": "novelai.generatePlot",
        "title": "本文からプロットを起こす",
        "category": "小説執筆",
        "icon": "$(sparkle)"
      },
      {
        "command": "novelai.openChat",
        "title": "AIに相談する",
        "category": "小説執筆",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "novelai.refresh",
        "title": "再読み込み",
        "category": "小説執筆",
        "icon": "$(refresh)"
      },
      {
        "command": "novelai.addEpisode",
        "title": "新規話数ファイルを追加",
        "category": "小説執筆",
        "icon": "$(new-file)"
      },
      {
        "command": "novelai.openWorkFolder",
        "title": "作品フォルダを開く",
        "category": "小説執筆"
      },
      {
        "command": "novelai.showWorkStats",
        "title": "作品の文字数を表示",
        "category": "小説執筆",
        "icon": "$(graph)"
      },
      {
        "command": "novelai.showWritingStats",
        "title": "執筆統計を表示",
        "category": "小説執筆",
        "icon": "$(graph-line)"
      },
      {
        "command": "novelai.showAllWorksWritingStats",
        "title": "全作品の執筆統計を表示",
        "category": "小説執筆",
        "icon": "$(graph-line)"
      },
      {
        "command": "novelai.setWorkGoals",
        "title": "この作品の目標を決める",
        "category": "小説執筆",
        "icon": "$(target)"
      },
      {
        "command": "novelai.setupAI",
        "title": "AI設定",
        "category": "小説執筆",
        "icon": "$(settings-gear)"
      },
      {
        "command": "novelai.exitChatFocus",
        "title": "作品一覧と操作メニューを出す",
        "category": "小説執筆",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "novelai.testAI",
        "title": "AI接続の確認",
        "category": "小説執筆"
      },
      {
        "command": "novelai.exportImeDictionary",
        "title": "IME辞書を出力",
        "category": "小説執筆",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "novelai.manageCustomFields",
        "title": "一覧に項目を増やす",
        "category": "小説執筆",
        "icon": "$(list-selection)"
      },
      {
        "command": "novelai.showSettingsForTerm",
        "title": "設定情報を表示",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.applyPendingUpdates",
        "title": "更新分を反映",
        "category": "小説執筆",
        "icon": "$(check-all)"
      },
      {
        "command": "novelai.unifyCharacters",
        "title": "重複をまとめる",
        "category": "小説執筆",
        "icon": "$(merge)"
      },
      {
        "command": "novelai.showLog",
        "title": "ログを開く",
        "category": "小説執筆",
        "icon": "$(output)"
      },
      {
        "command": "novelai.diagnoseWeb",
        "title": "動作を診断（ブラウザ版の確認用）",
        "category": "小説執筆",
        "icon": "$(pulse)"
      },
      {
        "command": "novelai.selectOllamaExecutable",
        "title": "Ollamaの実行ファイル位置を指定",
        "category": "小説執筆",
        "icon": "$(folder-opened)"
      },
      {
        "command": "novelai.openSettingsPanel",
        "title": "設定資料集を閲覧",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.extractSettings",
        "title": "設定資料をまとめて抽出",
        "category": "小説執筆",
        "icon": "$(sparkle)"
      },
      {
        "command": "novelai.extractCharactersOnly",
        "title": "人物を抽出",
        "category": "小説執筆",
        "icon": "$(person)"
      },
      {
        "command": "novelai.extractLocationsOnly",
        "title": "場所を抽出",
        "category": "小説執筆",
        "icon": "$(location)"
      },
      {
        "command": "novelai.extractAbilitiesOnly",
        "title": "スキルを抽出",
        "category": "小説執筆",
        "icon": "$(zap)"
      },
      {
        "command": "novelai.extractOrganizationsOnly",
        "title": "組織を抽出",
        "category": "小説執筆",
        "icon": "$(organization)"
      },
      {
        "command": "novelai.extractWorldOnly",
        "title": "世界観を抽出",
        "category": "小説執筆",
        "icon": "$(globe)"
      },
      {
        "command": "novelai.checkTypos",
        "title": "誤字脱字を検知",
        "category": "小説執筆",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "novelai.manageKeepWords",
        "title": "直さない語を管理",
        "category": "小説執筆",
        "icon": "$(circle-slash)"
      },
      {
        "command": "novelai.checkProofread",
        "title": "推敲する",
        "category": "小説執筆",
        "icon": "$(edit)"
      },
      {
        "command": "novelai.checkContradictions",
        "title": "矛盾を検知",
        "category": "小説執筆",
        "icon": "$(warning)"
      },
      {
        "command": "novelai.checkDeviations",
        "title": "プロットからの逸脱を検知",
        "category": "小説執筆",
        "icon": "$(compass)"
      },
      {
        "command": "novelai.checkNotation",
        "title": "表記ゆれを検知",
        "category": "小説執筆",
        "icon": "$(symbol-text)"
      },
      {
        "command": "novelai.checkTyposForFile",
        "title": "この話の誤字脱字を検知",
        "category": "小説執筆",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "novelai.deleteEpisodeFile",
        "title": "ファイルを削除",
        "category": "小説執筆",
        "icon": "$(trash)"
      },
      {
        "command": "novelai.generateSynopses",
        "title": "各話あらすじを生成",
        "category": "小説執筆",
        "icon": "$(list-ordered)"
      },
      {
        "command": "novelai.openSynopsisDocs",
        "title": "紹介文・あらすじを閲覧",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.generateWorkBlurb",
        "title": "作品紹介文を生成",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.generateCatchphrases",
        "title": "キャッチコピー案を作る",
        "category": "小説執筆",
        "icon": "$(megaphone)"
      },
      {
        "command": "novelai.generateSettingsDocs",
        "title": "設定資料集を出力（AIを使わない）",
        "category": "小説執筆",
        "icon": "$(sync)"
      },
      {
        "command": "novelai.gitSync",
        "title": "GitHubと同期",
        "category": "小説執筆",
        "icon": "$(git-branch)"
      },
      {
        "command": "novelai.gitPull",
        "title": "別の環境の変更を取り込む",
        "category": "小説執筆",
        "icon": "$(cloud-download)"
      },
      {
        "command": "novelai.gitPush",
        "title": "この環境の変更を送信する",
        "category": "小説執筆",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "novelai.resolveConflicts",
        "title": "競合解決",
        "category": "小説執筆",
        "icon": "$(git-merge)"
      },
      {
        "command": "novelai.createWorkWithPlot",
        "title": "新規作品を作成（プロットから）",
        "category": "小説執筆",
        "icon": "$(list-tree)"
      },
      {
        "command": "novelai.createWorkFromManuscript",
        "title": "新規作品を作成（本文から）",
        "category": "小説執筆",
        "icon": "$(edit)"
      },
      {
        "command": "novelai.addWorkFromGithub",
        "title": "GitHubから作品を追加",
        "category": "小説執筆",
        "icon": "$(cloud-download)"
      },
      {
        "command": "novelai.mergeIntoLibrary",
        "title": "作品を書庫にまとめる",
        "category": "小説執筆",
        "icon": "$(library)"
      },
      {
        "command": "novelai.gitRestore",
        "title": "過去の版に戻す（復元）",
        "category": "小説執筆",
        "icon": "$(history)"
      },
      {
        "command": "novelai.setupGithub",
        "title": "GitHubのセットアップ",
        "category": "小説執筆",
        "icon": "$(github)"
      },
      {
        "command": "novelai.setupOllama",
        "title": "Ollamaのセットアップ",
        "category": "小説執筆",
        "icon": "$(cloud-download)"
      },
      {
        "command": "novelai.openExtensionSettings",
        "title": "設定管理を開く",
        "category": "小説執筆",
        "icon": "$(settings)"
      },
      {
        "command": "novelai.generateCharacterDocs",
        "title": "人物一覧を生成（AIを使わない）",
        "category": "小説執筆",
        "icon": "$(person)"
      },
      {
        "command": "novelai.generateLocationDocs",
        "title": "場所一覧を生成（AIを使わない）",
        "category": "小説執筆",
        "icon": "$(location)"
      },
      {
        "command": "novelai.generateAbilityDocs",
        "title": "スキル一覧を生成（AIを使わない）",
        "category": "小説執筆",
        "icon": "$(zap)"
      },
      {
        "command": "novelai.generateWorldDocs",
        "title": "世界観一覧を生成（AIを使わない）",
        "category": "小説執筆",
        "icon": "$(globe)"
      },
      {
        "command": "novelai.setupVectorSearch",
        "title": "意味検索（ベクトルDB）の準備",
        "category": "小説執筆",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "novelai.buildVectorIndex",
        "title": "検索用の索引を作る・更新する",
        "category": "小説執筆",
        "icon": "$(database)"
      },
      {
        "command": "novelai.clearVectorIndex",
        "title": "検索用の索引を削除する",
        "category": "小説執筆",
        "icon": "$(trash)"
      },
      {
        "command": "novelai.runFullSetup",
        "title": "セットアップ（必要なものを入れる）",
        "category": "小説執筆",
        "icon": "$(checklist)"
      },
      {
        "command": "novelai.openChatLog",
        "title": "相談のログを開く",
        "category": "小説執筆",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "novelai.showVersion",
        "title": "バージョンを確認",
        "category": "小説執筆",
        "icon": "$(info)"
      },
      {
        "command": "novelai.chooseChatWork",
        "title": "相談する作品を選ぶ",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.convertToMarkdown",
        "title": "本文を .md にする",
        "category": "小説執筆",
        "icon": "$(markdown)"
      },
      {
        "command": "novelai.openVertical",
        "title": "縦書きで開く",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.addEmphasis",
        "title": "傍点を付ける",
        "category": "小説執筆",
        "icon": "$(three-bars)"
      },
      {
        "command": "novelai.addRuby",
        "title": "ルビを振る",
        "icon": "$(text-size)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.copyForPosting",
        "title": "投稿サイト用に変換してコピー",
        "icon": "$(clippy)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.importRuby",
        "title": "投稿サイトのルビを取り込む",
        "icon": "$(arrow-down)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.showEditHistory",
        "title": "編集履歴を見る",
        "category": "小説執筆",
        "icon": "$(history)"
      },
      {
        "command": "novelai.reviewProposals",
        "title": "編集部からの提案を見る",
        "icon": "$(inbox)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.toggleReviewLock",
        "title": "校閲を始める／終える",
        "icon": "$(lock)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.splitCollectedFile",
        "title": "話ごとのファイルに分ける",
        "category": "小説執筆",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "novelai.copySubtitle",
        "title": "サブタイトルをコピー",
        "icon": "$(clippy)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.copyBodyForPosting",
        "title": "本文を投稿サイト用にコピー",
        "icon": "$(clippy)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.renameWithSubtitle",
        "title": "ファイル名にサブタイトルを付ける",
        "icon": "$(edit)",
        "category": "小説執筆"
      },
      {
        "command": "novelai.switchMode",
        "title": "作者／編集者を切り替える",
        "category": "小説執筆",
        "icon": "$(person)"
      },
      {
        "command": "novelai.shareWithEditor",
        "title": "編集部へ渡す",
        "category": "小説執筆",
        "icon": "$(repo-push)"
      },
      {
        "command": "novelai.collectEditorProposals",
        "title": "編集部の提案を取り込む",
        "category": "小説執筆",
        "icon": "$(repo-pull)"
      },
      {
        "command": "novelai.plotInterview",
        "title": "対話でプロットを作る",
        "category": "小説執筆",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelai.addWork",
          "when": "view == novelai.works",
          "group": "navigation@1"
        },
        {
          "command": "novelai.addWorkFromGithub",
          "when": "view == novelai.works",
          "group": "navigation@2"
        },
        {
          "command": "novelai.createWork",
          "when": "view == novelai.works",
          "group": "navigation@3"
        },
        {
          "command": "novelai.refresh",
          "when": "view == novelai.works",
          "group": "navigation@4"
        },
        {
          "command": "novelai.exitChatFocus",
          "when": "view == novelai.chatView && novelai.focusChat",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "novelai.addEpisode",
          "when": "view == novelai.works && viewItem == work",
          "group": "inline"
        },
        {
          "command": "novelai.showWorkStats",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@1"
        },
        {
          "command": "novelai.showWritingStats",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@2"
        },
        {
          "command": "novelai.openSettingsPanel",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@3"
        },
        {
          "command": "novelai.extractSettings",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@4"
        },
        {
          "command": "novelai.generateSynopses",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@5"
        },
        {
          "command": "novelai.gitSync",
          "when": "view == novelai.works && viewItem == work",
          "group": "2_open@1"
        },
        {
          "command": "novelai.openWorkFolder",
          "when": "view == novelai.works && viewItem == work",
          "group": "2_open@2"
        },
        {
          "command": "novelai.removeWork",
          "when": "view == novelai.works && viewItem == work",
          "group": "9_danger"
        },
        {
          "command": "novelai.checkTyposForFile",
          "when": "view == novelai.works && viewItem == episode",
          "group": "1_actions@1"
        },
        {
          "command": "novelai.splitCollectedFile",
          "when": "view == novelai.works && viewItem == episode",
          "group": "1_actions@2"
        },
        {
          "command": "novelai.convertToMarkdown",
          "when": "view == novelai.works && viewItem == episode",
          "group": "1_actions@3"
        },
        {
          "command": "novelai.copySubtitle",
          "when": "view == novelai.works && viewItem == episode",
          "group": "2_copy@1"
        },
        {
          "command": "novelai.copyBodyForPosting",
          "when": "view == novelai.works && viewItem == episode",
          "group": "2_copy@2"
        },
        {
          "command": "novelai.renameWithSubtitle",
          "when": "view == novelai.works && viewItem == episode",
          "group": "2_copy@3"
        },
        {
          "command": "novelai.deleteEpisodeFile",
          "when": "view == novelai.works && viewItem == episode",
          "group": "9_danger"
        }
      ],
      "editor/context": [
        {
