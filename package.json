{
  "name": "novel-ai-assistant",
  "displayName": "小説AI執筆補助",
  "description": "小説執筆のための作品管理・文字数計測・AI支援機能",
  "version": "0.0.2",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelai",
          "title": "小説執筆",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "novelai": [
        {
          "id": "novelai.works",
          "name": "作品一覧"
        },
        {
          "id": "novelai.actions",
          "name": "操作メニュー"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelai.works",
        "contents": "まだ作品が登録されていません。\n[既存フォルダを作品として登録](command:novelai.addWork)\n[新規作品を作成](command:novelai.createWork)"
      }
    ],
    "commands": [
      {
        "command": "novelai.addWork",
        "title": "既存フォルダを作品として登録",
        "category": "小説執筆",
        "icon": "$(add)"
      },
      {
        "command": "novelai.createWork",
        "title": "新規作品を作成",
        "category": "小説執筆",
        "icon": "$(new-folder)"
      },
      {
        "command": "novelai.removeWork",
        "title": "作品の登録を解除",
        "category": "小説執筆"
      },
      {
        "command": "novelai.refresh",
        "title": "再読み込み",
        "category": "小説執筆",
        "icon": "$(refresh)"
      },
      {
        "command": "novelai.addEpisode",
        "title": "新規話数ファイルを追加",
        "category": "小説執筆",
        "icon": "$(new-file)"
      },
      {
        "command": "novelai.openWorkFolder",
        "title": "作品フォルダを開く",
        "category": "小説執筆"
      },
      {
        "command": "novelai.showWorkStats",
        "title": "作品の文字数を表示",
        "category": "小説執筆",
        "icon": "$(graph)"
      },
      {
        "command": "novelai.setupAI",
        "title": "AIの設定",
        "category": "小説執筆",
        "icon": "$(settings-gear)"
      },
      {
        "command": "novelai.testAI",
        "title": "AIの接続を確認",
        "category": "小説執筆"
      },
      {
        "command": "novelai.exportImeDictionary",
        "title": "IME辞書を出力",
        "category": "小説執筆",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "novelai.manageCustomFields",
        "title": "人物設定の項目を増やす",
        "category": "小説執筆",
        "icon": "$(list-selection)"
      },
      {
        "command": "novelai.showSettingsForTerm",
        "title": "カーソル位置の設定を右側に表示",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.applyPendingUpdates",
        "title": "更新分を反映",
        "category": "小説執筆",
        "icon": "$(check-all)"
      },
      {
        "command": "novelai.unifyCharacters",
        "title": "同一人物をまとめる",
        "category": "小説執筆",
        "icon": "$(merge)"
      },
      {
        "command": "novelai.showLog",
        "title": "ログを表示",
        "category": "小説執筆",
        "icon": "$(output)"
      },
      {
        "command": "novelai.selectOllamaExecutable",
        "title": "Ollamaの実行ファイルを選択",
        "category": "小説執筆",
        "icon": "$(folder-opened)"
      },
      {
        "command": "novelai.openSettingsPanel",
        "title": "設定資料を開く",
        "category": "小説執筆",
        "icon": "$(book)"
      },
      {
        "command": "novelai.extractSettings",
        "title": "設定資料を抽出",
        "category": "小説執筆",
        "icon": "$(sparkle)"
      },
      {
        "command": "novelai.generateSettingsDocs",
        "title": "設定資料集を出力（AIを使わない）",
        "category": "小説執筆",
        "icon": "$(sync)"
      },
      {
        "command": "novelai.gitSync",
        "title": "GitHubとの同期状態",
        "category": "小説執筆",
        "icon": "$(git-branch)"
      },
      {
        "command": "novelai.gitPull",
        "title": "別の環境の変更を取り込む",
        "category": "小説執筆",
        "icon": "$(cloud-download)"
      },
      {
        "command": "novelai.gitPush",
        "title": "この環境の変更を送信する",
        "category": "小説執筆",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "novelai.resolveConflicts",
        "title": "競合を解決する",
        "category": "小説執筆",
        "icon": "$(git-merge)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelai.addWork",
          "when": "view == novelai.works",
          "group": "navigation@1"
        },
        {
          "command": "novelai.createWork",
          "when": "view == novelai.works",
          "group": "navigation@2"
        },
        {
          "command": "novelai.refresh",
          "when": "view == novelai.works",
          "group": "navigation@3"
        },
        {
          "command": "novelai.setupAI",
          "when": "view == novelai.works",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "novelai.addEpisode",
          "when": "view == novelai.works && viewItem == work",
          "group": "inline"
        },
        {
          "command": "novelai.showWorkStats",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@1"
        },
        {
          "command": "novelai.openSettingsPanel",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@2"
        },
        {
          "command": "novelai.extractSettings",
          "when": "view == novelai.works && viewItem == work",
          "group": "1_stats@3"
        },
        {
          "command": "novelai.gitSync",
          "when": "view == novelai.works && viewItem == work",
          "group": "2_open@1"
        },
        {
          "command": "novelai.openWorkFolder",
          "when": "view == novelai.works && viewItem == work",
          "group": "2_open@2"
        },
        {
          "command": "novelai.removeWork",
          "when": "view == novelai.works && viewItem == work",
          "group": "9_danger"
        }
      ],
      "editor/context": [
        {
          "command": "novelai.showSettingsForTerm",
          "when": "resourceExtname == .txt || resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "novelai.removeWork",
          "when": "false"
        },
        {
          "command": "novelai.openWorkFolder",
          "when": "false"
        },
        {
          "command": "novelai.showWorkStats",
          "when": "false"
        },
        {
          "command": "novelai.extractSettings",
          "when": "true"
        },
        {
          "command": "novelai.generateSettingsDocs",
          "when": "true"
        },
        {
          "command": "novelai.gitSync",
          "when": "true"
        },
        {
          "command": "novelai.gitPull",
          "when": "true"
        },
        {
          "command": "novelai.gitPush",
          "when": "true"
        },
        {
          "command": "novelai.resolveConflicts",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "小説AI執筆補助",
      "properties": {
        "novelai.countMode": {
          "type": "string",
          "enum": [
            "net",
            "gross"
          ],
          "enumDescriptions": [
            "純文字数（改行・空白を除く）",
            "総文字数（改行を除き、空白を含む）"
          ],
          "default": "net",
          "description": "ステータスバーに表示する文字数の種類"
        },
        "novelai.excludeRubyFromCount": {
          "type": "boolean",
          "default": true,
          "description": "Markdownのルビ記法 {漢字|かんじ} のルビ部分を文字数から除外する"
        },
        "novelai.episodeFileExtension": {
          "type": "string",
          "enum": [
            ".txt",
            ".md"
          ],
          "default": ".txt",
          "description": "新規話数ファイルを作成するときの既定の拡張子"
        },
        "novelai.episodeNumberDigits": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "description": "新規話数ファイル名の数字の桁数（3なら 001.txt）"
        },
        "novelai.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "OllamaのエンドポイントURL"
        },
        "novelai.ollama.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`ollama` 実行ファイルの場所。**空なら自動検出**します（PATHと既定のインストール先を探索）。拡張機能からOllamaを起動するときにだけ使います。自動検出に失敗する場合のみ指定してください。\n\n[ファイルを選択…](command:novelai.selectOllamaExecutable)"
        },
        "novelai.ollama.numCtx": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "AIへ渡すコンテキスト長（トークン）。**0で自動**（モデルの上限と16384の小さい方）。Ollamaは既定値が小さく、指定しないと入力が切り捨てられます。大きくするとメモリ消費が増えます。"
        },
        "novelai.ollama.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "description": "1回のAI呼び出しのタイムアウト（秒）。大きいモデルでは延ばしてください。"
        },
        "novelai.claude.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "description": "Claudeの1回のAI呼び出しのタイムアウト（秒）。"
        },
        "novelai.maxOutputTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 1024,
          "markdownDescription": "1回の応答で受け取る最大トークン数（Claude・ChatGPT・Gemini共通）。**出力トークンは入力より単価が高い**ため、必要以上に大きくしないでください。モデルの上限を超える場合は上限に丸められます。\n\n小さすぎると応答が途中で切れ、**そのチャンクの結果は丸ごと捨てられます**（部分的なJSONは解析できないため）。呼び出し1回分が無駄になるので、節約しすぎないでください。"
        },
        "novelai.claude.maxOutputTokens": {
          "type": "number",
          "minimum": 1024,
          "markdownDescription": "Claude専用だった旧設定。`novelai.maxOutputTokens` を使ってください。",
          "deprecationMessage": "novelai.maxOutputTokens に統合されました。値を設定している場合はそちらが優先されます。"
        },
        "novelai.openai.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "ChatGPT（OpenAI API）のエンドポイントURL。互換サービスを使う場合のみ変更してください。"
        },
        "novelai.openai.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "description": "ChatGPTの1回のAI呼び出しのタイムアウト（秒）。"
        },
        "novelai.openai.contextWindow": {
          "type": "number",
          "default": 128000,
          "minimum": 1024,
          "markdownDescription": "ChatGPTのモデルのコンテキスト長（トークン）。**OpenAIのモデル一覧APIはこの値を返さない**ため、設定で指定します。本文の分割単位を決めるのに使うので、実際より大きいと入力が黙って切り捨てられます。使用するモデルの仕様に合わせてください。\n\nこの値を変更すると分割単位が変わり、処理済みチャンクのキャッシュが使えなくなります。"
        },
        "novelai.gemini.endpoint": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com/v1beta",
          "description": "GeminiのエンドポイントURL。通常は変更不要です。"
        },
        "novelai.gemini.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "description": "Geminiの1回のAI呼び出しのタイムアウト（秒）。"
        },
        "novelai.chunkChars": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "1チャンクの文字数。0でモデルのコンテキスト長から自動決定。"
        },
        "novelai.git.autoFetch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "作品フォルダーがGitリポジトリのとき、起動時と本文を開いたときに `git fetch` を実行し、別の環境の変更が未取得かどうかを確認します。**fetchは取得のみで、原稿にもブランチにも触れません。** 取り込み（pull）と送信（push）は、この設定に関わらず自動では実行しません。"
        },
        "novelai.git.syncCache": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "AIの処理済みキャッシュ（`.aiwriter/cache/`）をGitで同期します。**複数の環境を渡り歩いて執筆する場合は有効にしてください。** 無効のままだと、別のPCで作業を始めたときに全チャンクをAIで処理し直すことになります。キャッシュのキーには内容ハッシュ・モデル名・プロンプト版が含まれるので、条件が違う結果を再利用することはありません。切り替えると次回起動時に `.gitignore` へ規則を追記します（作者が書いた行は変更しません）。"
        },
        "novelai.git.autoFetchIntervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "自動fetchの最小間隔（分）。本文を開くたびにネットワークへ出ると、回線の遅い環境で操作が重くなるため、前回からこの時間が経つまでは取りに行きません。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:quality": "vitest run test/unit/characterExtractionQuality.test.ts --reporter=verbose",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:ollama": "vitest run --config vitest.live.config.mts",
    "compile:integration": "tsc -p tsconfig.test.json",
    "test:integration": "npm run build && npm run compile:integration && node scripts/runIntegrationTests.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "ci": "npm run typecheck && npm run test:unit && npm run test:quality && npm run test:coverage && npm run build && npm run test:integration && npm audit --audit-level=moderate",
    "check:release": "npm run check && npm run test:integration && npm audit --audit-level=moderate",
    "prepackage:vsix": "npm run check:release",
    "package:vsix": "node scripts/packageVsix.mjs",
    "verify:vsix": "node scripts/verifyVsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "^5.6.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "diff": "^8.0.4",
    "iconv-lite": "^0.7.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
